{
    "manifest_version": 3,

    "name": "Orbis",

    "version": "0.1.0",

    "description": "Real-Time AI Voice Translation & Zero-Shot Voice Cloning Overlay",

    "permissions": [
        "storage",
        "sidePanel"
    ],

    "action": {
        "default_title": "Open Orbis"
    },

    "side_panel": {
        "default_path": "sidepanel.html"
    },

    "background": {
        "service_worker": "background.js"
    }
}